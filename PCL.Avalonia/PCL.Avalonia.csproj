<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PCL.Avalonia</RootNamespace>
    <AssemblyName>PCL-CE</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>15</LangVersion>
    <ApplicationIcon>../Plain Craft Launcher 2/Images/icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Configurations>Debug;CI;Release;Beta</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <ProjectReference Include="../PCL.Launcher.Core/PCL.Launcher.Core.csproj" />
    <EmbeddedResource Include="../PCL.Core.Wpf/App/Localization/Languages/*.xaml" LogicalName="PCL.Languages.%(Filename).xml" />
    <EmbeddedResource Include="../Plain Craft Launcher 2/metadata.json" LogicalName="PCL.metadata.json" />
    <Content Include="Licenses/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../PCL.Launcher.Core/LICENCE" Link="LICENCE.Launcher" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
