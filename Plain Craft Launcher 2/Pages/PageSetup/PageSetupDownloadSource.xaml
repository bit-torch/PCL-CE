<local:MyPageRight x:Class="PCL.PageSetupDownloadSource"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PCL"
                    xmlns:loc="clr-namespace:PCL.Core.App.Localization;assembly=PCL.Core.Wpf"
                    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="{loc:Loc Setup.DownloadSource.Title}">
                <StackPanel Margin="25,37,25,15">
                    <TextBlock Text="{loc:Loc Setup.DownloadSource.Description}" TextWrapping="Wrap"
                               Opacity="0.7" Margin="0,0,0,10" />
                    <StackPanel x:Name="PanSourceList" />
                    <TextBlock x:Name="TextEmpty" Text="{loc:Loc Setup.DownloadSource.Empty}"
                               Opacity="0.5" Margin="2,6,0,6" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextNewSource" Height="30" MaxLength="500"
                                         HintText="{loc:Loc Setup.DownloadSource.Add.Hint}"
                                         KeyDown="TextNewSource_KeyDown" />
                        <local:MyButton x:Name="BtnAddSource" Grid.Column="1" Height="30"
                                        MinWidth="100" Padding="13,0" Margin="10,0,0,0"
                                        Text="{loc:Loc Setup.DownloadSource.Add}"
                                        Click="BtnAddSource_Click" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
