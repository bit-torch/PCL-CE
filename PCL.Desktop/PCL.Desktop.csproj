<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>PCL.Desktop</RootNamespace>
        <AssemblyName>PCL-CE</AssemblyName>
        <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets/*.png" />
        <AvaloniaResource Include="Assets/*.ico" />
        <AvaloniaResource Include="Localization/*.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.23" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../PCL.Kernel/PCL.Kernel.csproj" />
        <ProjectReference Include="../PCL.Kernel.Abstractions/PCL.Kernel.Abstractions.csproj" />
    </ItemGroup>

</Project>
