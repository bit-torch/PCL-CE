<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCL.Desktop.ViewModels"
             x:Class="PCL.Desktop.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <StackPanel Spacing="18">

        <Border Classes="card" Padding="30">
            <Grid ColumnDefinitions="Auto,*">
                <Border Width="64" Height="64" CornerRadius="20"
                        Background="{StaticResource BrandBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="P"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="22,0,0,0" Spacing="8">
                    <TextBlock Text="{Binding Title}" Classes="h2" />
                    <TextBlock Text="{Binding Version}" Classes="muted" />
                    <TextBlock Text="{Binding Attribution}" Classes="muted" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*,18,*">
            <Border Grid.Column="0" Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="许可证义务" Classes="section" />
                    <TextBlock Text="{Binding LicenseNotice}" Classes="muted" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="干净内核" Classes="section" />
                    <TextBlock Text="{Binding CleanRoomNotice}" Classes="muted" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Classes="card">
            <StackPanel Spacing="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="支持作者与项目" Classes="section" />
                    <TextBlock Classes="muted"
                               Text="如果你喜欢这份工作，请优先通过官方渠道购买 Minecraft，也可以赞助原 PCL 作者。" />
                </StackPanel>

                <WrapPanel ItemWidth="210" ItemHeight="46">
                    <Button Classes="primary"
                            Content="购买正版 Minecraft"
                            Command="{Binding OpenPurchaseCommand}"
                            Margin="0,0,12,10" />
                    <Button Classes="ghost"
                            Content="赞助原 PCL 作者"
                            Command="{Binding OpenSponsorCommand}"
                            Margin="0,0,12,10" />
                    <Button Classes="ghost"
                            Content="上游仓库"
                            Command="{Binding OpenUpstreamCommand}"
                            Margin="0,0,12,10" />
                    <Button Classes="ghost"
                            Content="社区仓库"
                            Command="{Binding OpenCommunityCommand}"
                            Margin="0,0,12,10" />
                </WrapPanel>

                <TextBlock Text="{Binding Status}" Classes="caption" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
