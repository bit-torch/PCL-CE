<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCL.Desktop.ViewModels"
             x:Class="PCL.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <StackPanel Spacing="18">

        <Border Classes="card" Padding="30">
            <Grid ColumnDefinitions="*,280">
                <StackPanel Spacing="14" VerticalAlignment="Center">
                    <Border Classes="accent-chip" HorizontalAlignment="Left">
                        <TextBlock Text="独立内核 · Avalonia"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>

                    <TextBlock Text="从一条干净的启动链路开始"
                               FontSize="32"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock Classes="muted"
                               MaxWidth="520"
                               Text="新内核只依赖 Mojang 官方接口与跨平台 .NET 能力。界面采用纵向导航、卡片分区和柔和层级，参考白板类应用的组织方式，不复刻其布局与素材。" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="primary"
                                Content="安装新版本"
                                Command="{Binding OpenInstallCommand}" />
                        <Button Classes="ghost"
                                Content="启动游戏"
                                Command="{Binding OpenLaunchCommand}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        CornerRadius="18"
                        Background="{StaticResource AccentSoftBrush}"
                        Padding="22"
                        Margin="24,0,0,0">
                    <StackPanel Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="迁移进度" Classes="section" />
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="内核骨架" Classes="muted" />
                                <TextBlock Grid.Column="1" Text="已就绪" Classes="caption" />
                            </Grid>
                            <ProgressBar Value="100" Maximum="100" />
                        </StackPanel>
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Avalonia 界面" Classes="muted" />
                                <TextBlock Grid.Column="1" Text="预览" Classes="caption" />
                            </Grid>
                            <ProgressBar Value="35" Maximum="100" />
                        </StackPanel>
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="旧 WPF 代码剥离" Classes="muted" />
                                <TextBlock Grid.Column="1" Text="待替换" Classes="caption" />
                            </Grid>
                            <ProgressBar Value="8" Maximum="100" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*,18,*,18,*">
            <Border Grid.Column="0" Classes="card" Padding="20">
                <StackPanel Spacing="9">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="28" Height="28" CornerRadius="9"
                                Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="1" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="已安装版本" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding InstalledCount}" Classes="stat" />
                    <TextBlock Text="来自本地 versions 目录" Classes="caption" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" Padding="20">
                <StackPanel Spacing="9">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="28" Height="28" CornerRadius="9"
                                Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="2" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Java 运行时" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding JavaStatus}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="自动扫描 JAVA_HOME 与常见目录" Classes="caption" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Classes="card" Padding="20">
                <StackPanel Spacing="9">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="28" Height="28" CornerRadius="9"
                                Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="3" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="最新正式版" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding LatestRelease}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="来自 Mojang 版本清单" Classes="caption" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="下一步" Classes="section" />
                    <TextBlock Classes="muted"
                               Text="{Binding GameDirectory, StringFormat='当前游戏目录：{0}'}" />
                    <TextBlock Text="{Binding Status}" Classes="caption" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <Button Classes="ghost" Content="打开游戏目录"
                            Command="{Binding OpenGameFolderCommand}" />
                    <Button Classes="ghost" Content="设置"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Classes="primary" Content="刷新状态"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
