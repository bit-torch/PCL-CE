<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCL.Desktop.ViewModels"
             xmlns:loc="using:PCL.Desktop.Localization"
             xmlns:mojang="using:PCL.Kernel.Mojang"
             xmlns:versions="using:PCL.Kernel.Versions"
             xmlns:loaders="using:PCL.Kernel.Loaders"
             x:Class="PCL.Desktop.Views.InstallView"
             x:DataType="vm:InstallViewModel">

    <StackPanel Spacing="18">

        <Border Classes="card">
            <StackPanel Spacing="18">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{loc:Localize Key=install.title}" Classes="h2" />
                        <TextBlock Classes="muted"
                                   Text="{loc:Localize Key=install.description}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Content="{loc:Localize Key=install.action.refresh}"
                            Command="{Binding LoadVersionsCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,14,Auto">
                    <ComboBox Grid.Column="0"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Versions}"
                              SelectedItem="{Binding SelectedVersion}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="mojang:VersionSummary">
                                <Grid ColumnDefinitions="*,110">
                                    <TextBlock Text="{Binding Id}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Type}"
                                               Classes="caption"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="2"
                            Classes="primary"
                            Content="{loc:Localize Key=install.action.install}"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                </Grid>

                <StackPanel Spacing="8" IsVisible="{Binding IsBusy}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Stage}" Classes="muted" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Progress, StringFormat='{}{0:0}%'}"
                                   Classes="caption" />
                    </Grid>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" />
                </StackPanel>

                <TextBlock Text="{Binding Status}" Classes="muted" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{loc:Localize Key=install.loader.title}" Classes="h2" />
                        <TextBlock Classes="muted"
                                   Text="{loc:Localize Key=install.loader.description}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Content="{loc:Localize Key=install.loader.refresh}"
                            Command="{Binding RefreshInstalledCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,12,*,12,*">
                    <ComboBox Grid.Column="0"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding InstalledVersions}"
                              SelectedItem="{Binding SelectedBaseVersion}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="versions:InstalledVersion">
                                <Grid ColumnDefinitions="*,90">
                                    <TextBlock Text="{Binding Id}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Type}"
                                               Classes="caption"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Grid.Column="2"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding LoaderOptions}"
                              SelectedItem="{Binding SelectedLoader}" />

                    <ComboBox Grid.Column="4"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding LoaderVersions}"
                              SelectedItem="{Binding SelectedLoaderVersion}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="loaders:LoaderVersion">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <StackPanel Spacing="8" IsVisible="{Binding IsLoaderBusy}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding LoaderStage}" Classes="muted" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LoaderProgress, StringFormat='{}{0:0}%'}"
                                   Classes="caption" />
                    </Grid>
                    <ProgressBar Value="{Binding LoaderProgress}" Maximum="100" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding LoaderStatus}" Classes="muted"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="primary"
                            Content="{loc:Localize Key=install.loader.install}"
                            Command="{Binding InstallLoaderCommand}"
                            IsEnabled="{Binding !IsLoaderBusy}" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,18,*">
            <Border Grid.Column="0" Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Localize Key=install.content.title}" Classes="section" />
                    <TextBlock Classes="muted" Text="{loc:Localize Key=install.content.json}" />
                    <TextBlock Classes="muted" Text="{loc:Localize Key=install.content.libs}" />
                    <TextBlock Classes="muted" Text="{loc:Localize Key=install.content.assets}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Localize Key=install.directory.title}" Classes="section" />
                    <TextBlock Classes="muted"
                               Text="{loc:Localize Key=install.directory.desc}" />
                    <TextBlock Classes="caption"
                               Text="{loc:Localize Key=install.directory.hint}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
