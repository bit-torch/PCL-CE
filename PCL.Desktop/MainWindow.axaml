<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCL.Desktop.ViewModels"
        x:Class="PCL.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="780"
        MinWidth="1000"
        MinHeight="660"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="96,*">

        <!-- 左侧导航栏：参考白板类应用的纵向工具栏，但使用独立的视觉语言。 -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Margin="0,26,0,18" Spacing="9" HorizontalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="15"
                            Background="{StaticResource BrandBrush}">
                        <TextBlock Text="P"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PCL"
                               Classes="caption"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Classes="nav"
                         ItemsSource="{Binding NavItems}"
                         SelectedIndex="{Binding SelectedNavIndex}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <Path Data="{Binding Icon}"
                                      Width="22"
                                      Height="22"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Label}"
                                           FontSize="12"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,0,0,22" Spacing="3"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ShellBadge}" Classes="caption" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ShellVersion}" Classes="caption" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <Grid Grid.Row="0" Margin="34,26,34,16" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding CurrentTitle}" Classes="h1" />
                    <TextBlock Text="{Binding CurrentSubtitle}" Classes="muted" />
                </StackPanel>

                <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Padding="34,0,34,30"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentPage}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
